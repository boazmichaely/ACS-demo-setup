# Copy to acs-demo-setup.local.env (gitignored) and fill in real values.
# export ACS_ENV_FILE=$PWD/acs-demo-setup.local.env
#
# Central (override auto-discovery from cluster route):
# export ACS_CENTRAL_ENDPOINT=https://central.example.apps.cluster.com:443
#
# RHACS API token (ROX_API_TOKEN if TOKEN unset):
# export TOKEN=
# export ROX_API_TOKEN=
#
# Splunk module: path to splunk-lab.sh if not default
# export ACS_SPLUNK_LAB_SCRIPT=$HOME/.cursor/skills/rhacs-splunk-ta-demo-skill/scripts/splunk-lab.sh
