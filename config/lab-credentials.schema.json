{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/boazmichaely/ACS-demo-setup/config/lab-credentials.schema.json",
  "title": "ACS demo lab credentials",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "centralCluster", "securedCluster"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "insecureSkipTlsVerify": {
      "type": "boolean",
      "default": false,
      "description": "When true, skip TLS certificate verification for RHACS Central HTTPS (lab only)"
    },
    "centralCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openshift", "central"],
      "properties": {
        "openshift": { "$ref": "#/$defs/openshiftAccess" },
        "central": { "$ref": "#/$defs/centralConsole" }
      }
    },
    "securedCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sameAsCentralCluster", "openshift"],
      "properties": {
        "sameAsCentralCluster": { "type": "boolean" },
        "openshift": { "$ref": "#/$defs/openshiftAccess" }
      }
    }
  },
  "$defs": {
    "openshiftAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consoleUrl", "adminUsername", "adminPassword"],
      "properties": {
        "consoleUrl": { "type": "string", "description": "OpenShift web console URL" },
        "adminUsername": { "type": "string" },
        "adminPassword": { "type": "string" }
      }
    },
    "centralConsole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consoleUrl",
        "apiToken",
        "adminUsername",
        "adminPassword",
        "authPreference"
      ],
      "properties": {
        "consoleUrl": { "type": "string", "description": "RHACS Central UI / API base URL" },
        "apiToken": { "type": "string" },
        "apiTokenName": {
          "type": "string",
          "description": "Label shown in Central when the token was created (e.g. Cursor-exp-2026-12-31)"
        },
        "apiTokenExpires": {
          "type": "string",
          "format": "date",
          "description": "Token expiration date (YYYY-MM-DD)"
        },
        "adminUsername": { "type": "string" },
        "adminPassword": { "type": "string" },
        "authPreference": {
          "type": "string",
          "enum": ["apiToken", "password"]
        }
      }
    }
  }
}
