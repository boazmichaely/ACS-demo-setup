{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/boazmichaely/ACS-demo-setup/config/lab-credentials.schema.json",
  "title": "ACS demo lab credentials",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "activeLabId", "labs"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2 },
    "activeLabId": {
      "type": "string",
      "description": "id of the lab currently used by the GUI and modules"
    },
    "labs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lab" }
    }
  },
  "$defs": {
    "openshiftAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consoleUrl", "adminUsername", "adminPassword"],
      "properties": {
        "consoleUrl": { "type": "string", "description": "OpenShift web console URL" },
        "adminUsername": { "type": "string" },
        "adminPassword": { "type": "string" }
      }
    },
    "centralConsole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consoleUrl",
        "apiToken",
        "adminUsername",
        "adminPassword",
        "authPreference"
      ],
      "properties": {
        "consoleUrl": { "type": "string", "description": "RHACS Central UI / API base URL" },
        "apiToken": { "type": "string" },
        "apiTokenName": {
          "type": "string",
          "description": "Label shown in Central when the token was created"
        },
        "apiTokenExpires": {
          "type": "string",
          "format": "date",
          "description": "Token expiration date (YYYY-MM-DD)"
        },
        "adminUsername": { "type": "string" },
        "adminPassword": { "type": "string" },
        "authPreference": {
          "type": "string",
          "enum": ["apiToken", "password"]
        }
      }
    },
    "securedCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sameAsCentralCluster", "openshift"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Display name (e.g. production, edge-west)" },
        "sameAsCentralCluster": { "type": "boolean" },
        "openshift": { "$ref": "#/$defs/openshiftAccess" }
      }
    },
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "insecureSkipTlsVerify",
        "centralCluster",
        "securedClusters",
        "activeSecuredClusterId"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "insecureSkipTlsVerify": {
          "type": "boolean",
          "default": false,
          "description": "Skip TLS certificate verification for RHACS Central HTTPS (lab only)"
        },
        "centralCluster": {
          "type": "object",
          "additionalProperties": false,
          "required": ["openshift", "central"],
          "properties": {
            "openshift": { "$ref": "#/$defs/openshiftAccess" },
            "central": { "$ref": "#/$defs/centralConsole" }
          }
        },
        "securedClusters": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/$defs/securedCluster" }
        },
        "activeSecuredClusterId": {
          "type": "string",
          "description": "User-selected securedClusters[].id for module oc work (OpenShift for modules)"
        }
      }
    }
  }
}
